# Greenhouse Job Board token — the {board_token} segment in
# https://boards.greenhouse.io/{board_token} and
# https://boards-api.greenhouse.io/v1/boards/{board_token}/jobs
EXPO_PUBLIC_GREENHOUSE_BOARD_TOKEN=your-board-token

# Optional: display name shown for the org. Defaults to a humanized board token.
EXPO_PUBLIC_GREENHOUSE_ORG_NAME=

# USAJOBS API — https://developer.usajobs.gov/
# Register at https://developer.usajobs.gov/apirequest/ to get a key.
# USAJOBS requires both the key AND the email you registered it with on every request
# (sent as the Authorization-Key and User-Agent headers).
EXPO_PUBLIC_USAJOBS_API_KEY=your-usajobs-api-key
EXPO_PUBLIC_USAJOBS_USER_AGENT=your-registered-email@example.com

# USAJOBS covers the whole federal government, so scope it with a keyword
# and/or location to keep results relevant.
EXPO_PUBLIC_USAJOBS_KEYWORD=student
EXPO_PUBLIC_USAJOBS_LOCATION=Washington, DC

# Supabase (Auth + DB) — https://supabase.com/dashboard/project/_/settings/api
# Find both values under Project Settings > API. Use the "anon" / "public" key —
# NEVER the "service_role" key, which must never be shipped in a client app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
